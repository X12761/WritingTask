<Page x:Class="WritingTask.pgFinal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WritingTask"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pgFinal" Loaded="PageLoaded">
    <Grid>
    
    <Grid.RowDefinitions>
      <RowDefinition Height="100"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>

    <RichTextBox Name="lblInfo" Grid.Row="0" FontSize="16" IsReadOnly="True"/>
    <Button Name="btnDebug" Content="Debug" Click="DebugClick" Grid.Row="2"/>
  </Grid>
</Page>
