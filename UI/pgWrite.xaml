<Page x:Class="WritingTask.pgWrite"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WritingTask"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GoWrite" Loaded="Page_Loaded" Unloaded="Page_Unloaded">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="100"/>
      <RowDefinition Height="35"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="40"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
      <TextBlock Text="Topic" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
      <TextBlock Name="lblTask" Text="Type" 
                 TextWrapping="Wrap" HorizontalAlignment="Stretch" FontSize="16"/>
    </StackPanel>

    <ToolBar Grid.Row="1" Grid.Column="0">
      <ToggleButton Content="B" FontWeight="Bold" 
                    Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=txtTask}" 
                    ToolTip="Жирный (Ctrl+B)" Width="30"/>

      <ToggleButton Content="I" FontStyle="Italic" 
                    Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=txtTask}" 
                    ToolTip="Курсив (Ctrl+I)" Width="30"/>

      <ToggleButton Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=txtTask}" 
                    ToolTip="Подчеркнутый (Ctrl+U)" Width="30">
        <TextBlock Text="U" TextDecorations="Underline" />
      </ToggleButton>
      <Separator/>
      <Button Content="Left" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=txtTask}"/>
      <Button Content="Center" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=txtTask}"/>
      <Button Content="Right" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=txtTask}"/>
    </ToolBar>

    <RichTextBox Name="txtTask" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" FontSize="14"
                 AcceptsTab="True" AcceptsReturn="True" FontFamily="Times New Roman"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                PreviewKeyDown="editKeyDown" PreviewKeyUp="editKeyUp" />

    <StatusBar Grid.Column="0" Grid.Row="3">
      <StatusBarItem Margin="10,0">
        <TextBlock Text="Logged:" FontSize="16"/>
      </StatusBarItem>
      <StatusBarItem Margin="10,0">
        <TextBlock Text="{Binding KeyCount}" FontSize="16" FontWeight="Bold"/>
      </StatusBarItem>
    </StatusBar>
    <!-- Splitter -->
    <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="5" ResizeDirection="Columns" Width="3" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

    <!-- Right panel -->
    <TextBlock Name="lblElapsed" Text="00:00:00" Grid.Row="0" Grid.Column="2"
               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24"/>
    <Button Content="Done" Grid.Row="3" Grid.Column="2" Height="35" Click="DoneClick"/>

    <!-- AI meter-->
    <Frame Name="scoreFrame" Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" 
           JournalOwnership="OwnsJournal" NavigationUIVisibility="Hidden"/>
  </Grid>
</Page>
