<Page x:Class="WritingTask.pgAIDetect"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WritingTask"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="200"
      Title="pgAIScore" Loaded="FrameLoaded">

  <DockPanel>
    <TextBlock Name="aiMeter" Text="AI monitor" DockPanel.Dock="Top"
               FontSize="20" FontWeight="SemiBold"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border Grid.Row="2" Grid.Column="3" Background="White" 
        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="20"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="30"/>
          <RowDefinition Height="20"/>
          <RowDefinition Height="20"/>
          <RowDefinition Height="20"/>
          <RowDefinition Height="20"/>
          <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Detected emotion" Grid.Row="0" FontSize="20" 
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Image Grid.Row="1" Source="{Binding EmotionImg}"/>

        <TextBlock Text="{Binding Emotion}" Grid.Row="2" FontSize="24"  FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Confidence}" Grid.Row="3" FontSize="20"  FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ProgressBar Grid.Row="5" FontSize="30" Value="{Binding ConfidenceVal}" HorizontalAlignment="Stretch"/>
      </Grid>
    </Border>
  </DockPanel>
</Page>
