<Page x:Class="WritingTask.pgLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WritingTask"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pgLogin" Loaded="PageLoaded">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="40"/>
      <RowDefinition Height="40"/>
      <RowDefinition Height="40"/>
      <RowDefinition Height="40"/>
      <RowDefinition Height="40"/>
      <RowDefinition Height="50"/>
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="50"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Please answer a fiew quesions about yourself"
               HorizontalAlignment="Center"/>
    <TextBlock Grid.Row="1" Text="Age" HorizontalAlignment="Right"/>
    <TextBlock Grid.Row="2" Text="Gender" VerticalAlignment="Top" HorizontalAlignment="Right"/>
    <TextBlock Grid.Row="3" Text="Language background"  HorizontalAlignment="Right"/>
    <TextBlock Grid.Row="4" Text="English proficiency"  HorizontalAlignment="Right"/>
    <TextBlock Grid.Row="5" Text="Type experience years" TextWrapping="Wrap"/>

    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding age}" Width="100" HorizontalAlignment="Left" />
    <ComboBox Grid.Row="2" Grid.Column="2" Text="{Binding gender}" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="Female"/>
      <ComboBoxItem Content="Male"/>
      <ComboBoxItem Content="Prefer not to say"/>
    </ComboBox>
    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding lang}" HorizontalAlignment="Stretch"
             ToolTip="e.g. Korean, English, Mayan"/>
    <ComboBox Grid.Row="4" Grid.Column="2" Text="{Binding english}" HorizontalAlignment="Stretch" >
      <ComboBoxItem Content="A1"/>
      <ComboBoxItem Content="A2"/>
      <ComboBoxItem Content="B1"/>
      <ComboBoxItem Content="B2"/>
      <ComboBoxItem Content="C1"/>
      <ComboBoxItem Content="C2"/>
    </ComboBox>
    <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding prof}" Width="100" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="6" Text="Code"/>
    <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal">
      <TextBox Name="txtCode" Text="N/A" Width="100" Margin="0,0,20,0"/>
      <Button Name="btnSet" Content="Set" Click="SetClick" HorizontalAlignment="Right"/>
    </StackPanel>

    <Button Grid.Row="7" Grid.Column="2" Content="Next" Click="NextClick" HorizontalAlignment="Right"/>
  </Grid>
</Page>
