<Page x:Class="WritingTask.pgDebug"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WritingTask"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pgDebug">

    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="35"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <Button Content="Session" Click="NextClick" HorizontalAlignment="Left" Height="30"/>
      <TextBox Name="lblSession"/>
      <Button Content="Back" Click="BackClick" HorizontalAlignment="Left" Height="30"/>
    </StackPanel>
      
    <DataGrid Name="LogDataGrid" Grid.Row="1"
          AutoGenerateColumns="False" 
          IsReadOnly="True" 
          CanUserAddRows="False"
          GridLinesVisibility="Horizontal"
          HeadersVisibility="Column"
          Margin="10">

      <DataGrid.Columns>
        <!-- Клавиша -->
        <DataGridTextColumn Header="Клавиша" 
                            Binding="{Binding KeyName}" 
                            Width="100" 
                            FontFamily="Consolas" FontWeight="Bold"/>

        <!-- Время нажатия (форматируем до 1 знака после запятой) -->
        <DataGridTextColumn Header="Нажата (мс)" 
                            Binding="{Binding PressedAtMs, StringFormat='{}{0:F1}'}" 
                            Width="100"/>

        <!-- Время отпускания -->
        <DataGridTextColumn Header="Отпущена (мс)" 
                            Binding="{Binding ReleasedAtMs, StringFormat='{}{0:F1}'}" 
                            Width="100"/>

        <!-- Длительность -->
        <DataGridTextColumn Header="Длительность (мс)" 
                            Binding="{Binding DurationMs, StringFormat='{}{0:F1}'}" 
                            Width="120"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Page>
