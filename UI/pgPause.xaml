<Page x:Class="WritingTask.pgPause"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WritingTask"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pgPause">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="50"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>
    
    <TextBlock Name="lblRemain" Grid.Row="0" FontSize="24" FontWeight="Bold"
               HorizontalAlignment="Center"/>
    <RichTextBox Name="lblInfo" Grid.Row="1" FontSize="16" IsReadOnly="True"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
    <Button Name="btnContinue" Content="Start writing" IsEnabled="False" Click="ContinueClick" />
    <Button Name="btnDebug" Content="Debug" Visibility="Collapsed" Click="DebugClick"/>
    </StackPanel>
  </Grid>
</Page>
